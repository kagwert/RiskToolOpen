%% ============================================================
%  SYSTEMATIC DURATION STRATEGY  —  6-Rule Model
%  Complete self-contained script: data → signals → backtest → charts
%
%  Strategy rules (evaluated in priority order)
%    R1  RISING  (SHORT):  real_rate < -2.5%  AND  ff < 2.5%
%    R2  FALLING (LONG):   ff > 5.0%  AND  slope < 2.0%  AND  ff_chg_3m <= 0.25%
%    R3  RISING  (SHORT):  ff_chg_3m > 0.25%  AND  cpi > 3.5%
%    R4  RISING  (SHORT):  y5_mom_6m > 1.25%
%    R5  FALLING (LONG):   ff_chg_3m < -0.25%  AND  ff < 4.0%
%    R6  FALLING (LONG):   carry > 1.5%  AND  ff < 2.0%  AND  ff_chg_3m > -0.1%
%    else SIDEWAYS (NEUTRAL)
%
%  Implementation
%    Persistence filter : 3 months (suppress whipsaws)
%    Implementation lag : 1 month  (end-of-month rebalance)
%
%  Positions
%    FALLING  ->  LONG    +2Y tilt  ->  6Y duration  (7Y yield proxy)
%    SIDEWAYS ->  NEUTRAL  0Y tilt  ->  4Y duration  (5Y yield proxy)
%    RISING   ->  SHORT   -2Y tilt  ->  2Y duration  (2Y yield proxy)
%
%  Performance (real FRED data, 1993-2024)
%    Active Ann = +0.82%   IR = 0.42   MDD_active = -4.6%
%    Cumulative active return = +28.8%   Regime switches = 22
%
%  Sections
%    1. Configuration
%    2. FRED data download
%    3. Feature engineering
%    4. Rule-based signal generation
%    5. Persistence filter & implementation lag
%    6. P&L backtest
%    7. Performance statistics
%    8. Charts (3 figures)
%
%  Requirements
%    MATLAB R2020b+  (no toolboxes required beyond base MATLAB)
%    FRED API key    ->  set FRED_API_KEY below
%    Internet access ->  api.stlouisfed.org
%  ============================================================

clear; clc; close all;

%% ============================================================
%  SECTION 1 — CONFIGURATION
%  ============================================================

FRED_API_KEY   = 'YOUR_FRED_API_KEY_HERE';   % <-- insert your key
DATE_START     = '1990-01-01';
DATE_END       = datestr(now, 'yyyy-mm-dd');  % through today

PERSIST_MONTHS = 3;    % months a candidate regime must persist before adopting
IMPL_LAG       = 1;    % months between signal date and position entry

% ── Rule thresholds (validated on 1993-2024 real FRED data) ─
R1_RR_TH    = -2.5;   % real rate (5Y yield - CPI YoY) threshold for R1 -> SHORT
R1_FF_MAX   =  2.5;   % FF ceiling for R1
R2_FF_MIN   =  5.0;   % FF floor for R2 (peak FF) -> LONG
R2_SL_MAX   =  2.0;   % 7Y-2Y slope ceiling for R2
R2_C3_MAX   =  0.25;  % ff_chg_3m ceiling for R2
R3_C3_MIN   =  0.25;  % ff_chg_3m floor for R3 (hiking) -> SHORT
R3_CPI_MIN  =  3.5;   % CPI YoY floor for R3
R4_MOM_MIN  =  1.25;  % 6m yield momentum floor for R4 -> SHORT
R5_C3_MAX   = -0.25;  % ff_chg_3m ceiling for R5 (cutting) -> LONG
R5_FF_MAX   =  4.0;   % FF ceiling for R5
R6_CARRY_MIN=  1.5;   % carry (5Y-FF) floor for R6 -> LONG
R6_FF_MAX   =  2.0;   % FF ceiling for R6
R6_C3_MIN   = -0.1;   % ff_chg_3m floor for R6 (not actively cutting)

OUT_DIR = fullfile(pwd, 'duration_strategy_output');
if ~exist(OUT_DIR, 'dir'), mkdir(OUT_DIR); end

fprintf('=== SYSTEMATIC DURATION STRATEGY (6-Rule Model) ===\n');
fprintf('Date range: %s to %s\n\n', DATE_START, DATE_END);

%% ============================================================
%  SECTION 2 — FRED DATA DOWNLOAD
%  ============================================================

fprintf('[1] Downloading FRED data...\n');

series_ids  = {'DGS2','DGS5','DGS7','DFF','CPIAUCSL'};
field_names = {'yield_2y','yield_5y','yield_7y','fed_funds','cpi_raw'};

% Build a monthly date grid (month-end)
grid_start = datetime(DATE_START,'InputFormat','yyyy-MM-dd');
grid_end   = dateshift(datetime(DATE_END,'InputFormat','yyyy-MM-dd'),'end','month');
all_months = (grid_start : calmonths(1) : grid_end)';
all_months = dateshift(all_months, 'end', 'month');
N_months   = length(all_months);

D = NaN(N_months, length(series_ids));

for k = 1:length(series_ids)
    sid = series_ids{k};
    url = ['https://api.stlouisfed.org/fred/series/observations?series_id=' sid ...
           '&api_key=' FRED_API_KEY ...
           '&file_type=json&observation_start=' DATE_START '&observation_end=' DATE_END];
    try
        resp = webread(url);
        obs  = resp.observations;
        n    = length(obs);
        raw_dates = NaT(n,1);
        raw_vals  = NaN(n,1);
        for i = 1:n
            raw_dates(i) = datetime(obs(i).date,'InputFormat','yyyy-MM-dd');
            raw_vals(i)  = str2double(obs(i).value);
        end
        ok        = ~isnan(raw_vals);
        raw_dates = raw_dates(ok);
        raw_vals  = raw_vals(ok);
        me_dates  = dateshift(raw_dates, 'end', 'month');
        [u_dates, ~, ic] = unique(me_dates);
        u_vals    = accumarray(ic, raw_vals, [], @(x) x(end));
        [~, ia, ib] = intersect(all_months, u_dates);
        D(ia, k)  = u_vals(ib);
        fprintf('  %-12s  %d monthly obs  (%s to %s)\n', sid, length(u_vals), ...
            datestr(u_dates(1),'yyyy-mm'), datestr(u_dates(end),'yyyy-mm'));
    catch ME
        error('Failed to download %s: %s\nCheck FRED_API_KEY and connectivity.', ...
              sid, ME.message);
    end
end

% Assemble struct-of-arrays (no timetable — avoids dimension-name issues)
S.dates     = all_months;
S.yield_2y  = D(:,1);
S.yield_5y  = D(:,2);
S.yield_7y  = D(:,3);
S.fed_funds = D(:,4);
S.cpi_raw   = D(:,5);

% Forward-fill remaining NaNs
for k = 1:length(field_names)
    S.(field_names{k}) = ffill_col(S.(field_names{k}));
end

% Drop rows where any primary series is still missing
keep = ~isnan(S.yield_5y) & ~isnan(S.fed_funds) & ...
       ~isnan(S.yield_2y) & ~isnan(S.yield_7y);
flds = [{'dates'}, field_names];
for k = 1:length(flds), S.(flds{k}) = S.(flds{k})(keep); end
N = length(S.dates);
fprintf('  Master data: %d months (%s to %s)\n\n', N, ...
    datestr(S.dates(1),'yyyy-mm'), datestr(S.dates(end),'yyyy-mm'));

%% ============================================================
%  SECTION 3 — FEATURE ENGINEERING
%  ============================================================

fprintf('[2] Engineering features...\n');

% CPI year-on-year (%)
S.cpi_yoy    = (S.cpi_raw ./ mlag(S.cpi_raw, 12) - 1) * 100;

% Real rate: 5Y yield minus CPI YoY
S.real_rate  = S.yield_5y - S.cpi_yoy;

% Fed Funds 3-month change  (+ = hiking, - = cutting)
S.ff_chg_3m  = S.fed_funds - mlag(S.fed_funds, 3);

% Yield curve slope: 7Y minus 2Y
S.slope      = S.yield_7y - S.yield_2y;

% 5Y yield 6-month momentum  (+ = yields rising = bearish)
S.y5_mom_6m  = S.yield_5y - mlag(S.yield_5y, 6);

% Carry: 5Y yield minus Fed Funds
S.carry      = S.yield_5y - S.fed_funds;

% Valid feature rows (all features present)
feat_ok = ~isnan(S.cpi_yoy)   & ~isnan(S.real_rate) & ...
          ~isnan(S.ff_chg_3m) & ~isnan(S.slope)     & ...
          ~isnan(S.y5_mom_6m) & ~isnan(S.carry);

fprintf('  Feature-complete rows: %d of %d\n', sum(feat_ok), N);
fprintf('  Features: real_rate, ff_chg_3m, slope, cpi_yoy, y5_mom_6m, carry\n\n');

%% ============================================================
%  SECTION 4 — RULE-BASED SIGNAL GENERATION
%  ============================================================

fprintf('[3] Applying 6-rule signal...\n');

S.signal_raw = repmat("SIDEWAYS", N, 1);

for i = 1:N
    if ~feat_ok(i), continue; end

    ff  = S.fed_funds(i);
    c3  = S.ff_chg_3m(i);
    rr  = S.real_rate(i);
    sl  = S.slope(i);
    cpi = S.cpi_yoy(i);
    mom = S.y5_mom_6m(i);
    cr  = S.carry(i);

    % R1: Negative real rate trap -> SHORT
    if rr < R1_RR_TH && ff < R1_FF_MAX
        S.signal_raw(i) = "RISING";

    % R2: Peak FF, flat/inverted curve, not actively hiking -> LONG
    elseif ff > R2_FF_MIN && sl < R2_SL_MAX && c3 <= R2_C3_MAX
        S.signal_raw(i) = "FALLING";

    % R3: Active hiking with elevated inflation -> SHORT
    elseif c3 > R3_C3_MIN && cpi > R3_CPI_MIN
        S.signal_raw(i) = "RISING";

    % R4: Yield trend momentum -> SHORT (catches stealth / gradual hiking)
    elseif mom > R4_MOM_MIN
        S.signal_raw(i) = "RISING";

    % R5: Active cutting cycle -> LONG (regardless of FF level)
    elseif c3 < R5_C3_MAX && ff < R5_FF_MAX
        S.signal_raw(i) = "FALLING";

    % R6: High carry, Fed on hold at low rates -> LONG
    elseif cr > R6_CARRY_MIN && ff < R6_FF_MAX && c3 > R6_C3_MIN
        S.signal_raw(i) = "FALLING";

    % else: SIDEWAYS (already initialised)
    end
end

n_fall_raw = sum(S.signal_raw == "FALLING");
n_rise_raw = sum(S.signal_raw == "RISING");
n_side_raw = sum(S.signal_raw == "SIDEWAYS");
fprintf('  Raw signal distribution: LONG=%d  NEUTRAL=%d  SHORT=%d\n\n', ...
    n_fall_raw, n_side_raw, n_rise_raw);

%% ============================================================
%  SECTION 5 — PERSISTENCE FILTER & IMPLEMENTATION LAG
%  ============================================================

fprintf('[4] Applying persistence filter (%d months) and lag (%d month)...\n', ...
    PERSIST_MONTHS, IMPL_LAG);

S.signal_filtered = apply_persistence(S.signal_raw, PERSIST_MONTHS);

% Apply implementation lag: signal at T -> position at T+IMPL_LAG
S.position = [repmat("SIDEWAYS", IMPL_LAG, 1); ...
              S.signal_filtered(1:end-IMPL_LAG)];

sw_total = sum(S.position(2:end) ~= S.position(1:end-1));
n_fall   = sum(S.position == "FALLING");
n_side   = sum(S.position == "SIDEWAYS");
n_rise   = sum(S.position == "RISING");

fprintf('  After filter+lag:  LONG=%d  NEUTRAL=%d  SHORT=%d  Switches=%d\n\n', ...
    n_fall, n_side, n_rise, sw_total);

%% ============================================================
%  SECTION 6 — P&L BACKTEST
%  ============================================================

fprintf('[5] Running P&L backtest...\n');

dy2 = [NaN; diff(S.yield_2y)] / 100;
dy5 = [NaN; diff(S.yield_5y)] / 100;
dy7 = [NaN; diff(S.yield_7y)] / 100;

strat_ret = NaN(N, 1);
bmark_ret = NaN(N, 1);

for i = 2:N
    pos = S.position(i);
    if isnan(dy5(i)), continue; end
    switch pos
        case "FALLING",  strat_ret(i) = -6.0 * dy7(i);
        case "SIDEWAYS", strat_ret(i) = -4.0 * dy5(i);
        case "RISING",   strat_ret(i) = -2.0 * dy2(i);
        otherwise, continue;
    end
    if isnan(strat_ret(i)), continue; end
    bmark_ret(i) = -4.0 * dy5(i);
end

% Fill neutral months: strategy earns benchmark (active contribution = 0)
strat_fill = strat_ret;
neutral_mask = isnan(strat_ret) & ~isnan(bmark_ret);
strat_fill(neutral_mask) = bmark_ret(neutral_mask);

ok         = ~isnan(strat_fill) & ~isnan(bmark_ret);
cum_s      = cumprod(1 + strat_fill(ok)) * 100;
cum_b      = cumprod(1 + bmark_ret(ok))  * 100;

cum_s_full = NaN(N,1); cum_s_full(ok) = cum_s;
cum_b_full = NaN(N,1); cum_b_full(ok) = cum_b;
active_pct = NaN(N,1); active_pct(ok) = (cum_s ./ cum_b - 1) * 100;

%% ============================================================
%  SECTION 7 — PERFORMANCE STATISTICS
%  ============================================================

fprintf('[6] Computing performance statistics...\n');

act_ret = strat_fill(ok) - bmark_ret(ok);
[ar_s, av_s, sr_s, mdd_s, hit_s] = ann_stats(strat_fill(ok));
[ar_b, av_b, sr_b, mdd_b, ~    ] = ann_stats(bmark_ret(ok));
[ar_a, av_a, ir_a, mdd_a, hit_a] = ann_stats(act_ret);

fprintf('\n  %-26s  %9s  %9s  %9s\n','Metric','Strategy','Benchmark','Active');
fprintf('  %s\n', repmat('-',1,63));
fprintf('  %-26s  %+8.2f%%  %+8.2f%%  %+8.2f%%\n', 'Ann. Return',    ar_s*100,ar_b*100,ar_a*100);
fprintf('  %-26s  %8.2f%%  %8.2f%%  %8.2f%%\n',  'Ann. Volatility', av_s*100,av_b*100,av_a*100);
fprintf('  %-26s  %9.2f  %9.2f  %9.2f\n',        'Sharpe / IR',      sr_s,    sr_b,    ir_a);
fprintf('  %-26s  %8.1f%%  %8.1f%%  %8.1f%%\n',  'Max Drawdown',    mdd_s*100,mdd_b*100,mdd_a*100);
fprintf('  %-26s  %8.0f%%  ---        %8.0f%%\n','Monthly Hit Rate', hit_s*100,hit_a*100);
fprintf('  %-26s  ---        ---        %9d\n',  'Regime switches',  sw_total);
fprintf('  %-26s  %9d\n', 'LONG months',    n_fall);
fprintf('  %-26s  %9d\n', 'NEUTRAL months', n_side);
fprintf('  %-26s  %9d\n', 'SHORT months',   n_rise);

last_ok = find(ok,1,'last');
fprintf('  %-26s  %+8.1f%%\n', 'Cumul. active return', active_pct(last_ok));

% Sub-period breakdown
fprintf('\n  Sub-period active return (cumulative %%pts):\n');
period_bounds = [1994,1999; 2000,2007; 2008,2015; 2016,2021; 2022,2024];
for k = 1:size(period_bounds,1)
    yr_s = period_bounds(k,1); yr_e = period_bounds(k,2);
    mask = ok & year(S.dates) >= yr_s & year(S.dates) <= yr_e;
    if sum(mask) < 2, continue; end
    act_sub = strat_fill(mask) - bmark_ret(mask);
    cum_sub = (prod(1+act_sub)-1)*100;
    fprintf('    %d-%d:  %+.1f%%\n', yr_s, yr_e, cum_sub);
end

% Save backtest CSV
dates_str = cellstr(datestr(S.dates,'yyyy-mm'));
T_out = table(dates_str, strat_ret, bmark_ret, cum_s_full, cum_b_full, ...
              active_pct, cellstr(S.signal_raw), cellstr(S.position), ...
              'VariableNames',{'date','strat_ret','bmark_ret','cum_strat', ...
                               'cum_bmark','active_pct','signal_raw','position'});
writetable(T_out, fullfile(OUT_DIR,'backtest_results.csv'));
fprintf('\n  Results saved -> backtest_results.csv\n');

%% ============================================================
%  SECTION 8 — CHARTS
%  ============================================================

fprintf('[7] Generating charts...\n');

DATES  = S.dates;
Y2     = S.yield_2y;
FF     = S.fed_funds;
POS    = S.position;
tilt   = pos_to_tilt(POS);

C_FALL = [0.18 0.44 0.64];
C_RISE = [0.75 0.22 0.17];
C_SIDE = [0.50 0.50 0.50];
C_DARK = [0.10 0.13 0.18];
C_GRN  = [0.12 0.52 0.25];

% ── Figure 1: Rule logic diagram ─────────────────────────────
fig1 = figure('Name','6-Rule Decision Diagram','NumberTitle','off', ...
    'Position',[50 50 1350 720],'Color','w');
ax = axes(fig1,'Visible','off','Position',[0 0 1 1]);
hold(ax,'on'); xlim(ax,[0 30]); ylim(ax,[-0.5 11.5]);

FC_F=[0.84 0.91 0.97]; EC_F=C_FALL;
FC_R=[0.99 0.91 0.91]; EC_R=C_RISE;
FC_S=[0.92 0.92 0.93]; EC_S=C_SIDE;
FC_N=[0.99 0.99 1.00]; EC_N=[0.67 0.68 0.72];

% Rule condition boxes
rule_labels = { ...
    'R1  NEGATIVE REAL RATE TRAP',   'real\_rate < -2.5%  AND  ff\_lev < 2.5%'; ...
    'R2  PEAK FED FUNDS',            'ff\_lev > 5.0%  AND  slope < 2.0%  AND  ff\_chg\_3m \leq 0.25%'; ...
    'R3  HIKING WITH INFLATION',     'ff\_chg\_3m > 0.25%  AND  cpi\_yoy > 3.5%'; ...
    'R4  YIELD TREND SHORT',         'y5\_mom\_6m > 1.25%'; ...
    'R5  ACTIVE CUTTING CYCLE',      'ff\_chg\_3m < -0.25%  AND  ff\_lev < 4.0%'; ...
    'R6  HIGH CARRY, ON HOLD',       'carry > 1.5%  AND  ff\_lev < 2.0%  AND  ff\_chg\_3m > -0.1%'};
rule_y    = [9.8 8.4 7.0 5.6 4.2 2.8];
rule_fc   = {FC_R,FC_F,FC_R,FC_R,FC_F,FC_F};
rule_ec   = {EC_R,EC_F,EC_R,EC_R,EC_F,EC_F};
rule_out  = {'RISING (SHORT)','FALLING (LONG)','RISING (SHORT)', ...
             'RISING (SHORT)','FALLING (LONG)','FALLING (LONG)'};

for r = 1:6
    rectangle('Parent',ax,'Position',[0.4 rule_y(r)-0.42 17.2 0.84], ...
        'Curvature',0.09,'FaceColor',rule_fc{r},'EdgeColor',rule_ec{r},'LineWidth',1.4);
    text(ax,0.9,rule_y(r)+0.18,sprintf('R%d',r),'FontSize',11, ...
        'FontWeight','bold','Color',rule_ec{r},'Interpreter','none');
    text(ax,2.2,rule_y(r)+0.18,rule_labels{r,1},'FontSize',9.5, ...
        'FontWeight','bold','Color',C_DARK,'Interpreter','tex');
    text(ax,2.2,rule_y(r)-0.16,rule_labels{r,2},'FontSize',8.5, ...
        'FontAngle','italic','Color',[0.35 0.35 0.35],'Interpreter','tex');
    % Arrow to output
    plot(ax,[17.6 19.0],[rule_y(r) rule_y(r)],'Color',[0.55 0.55 0.55],'LineWidth',1.1);
    patch(ax,[19.0 18.6 18.6],[rule_y(r) rule_y(r)+0.13 rule_y(r)-0.13], ...
        [0.55 0.55 0.55],'EdgeColor','none');
    % Output box
    fc_out = rule_fc{r}; ec_out = rule_ec{r};
    rectangle('Parent',ax,'Position',[19.1 rule_y(r)-0.37 9.0 0.74], ...
        'Curvature',0.12,'FaceColor',fc_out,'EdgeColor',ec_out,'LineWidth',1.8);
    text(ax,23.6,rule_y(r),rule_out{r},'HorizontalAlignment','center','FontSize',9.5, ...
        'FontWeight','bold','Color',C_DARK,'Interpreter','none');
    % Priority annotation
    text(ax,0.08,rule_y(r),sprintf('P%d',r),'FontSize',7.5, ...
        'Color',[0.60 0.60 0.60],'VerticalAlignment','middle');
end

% ELSE box
rectangle('Parent',ax,'Position',[0.4 1.4 17.2 0.84], ...
    'Curvature',0.09,'FaceColor',FC_S,'EdgeColor',EC_S,'LineWidth',1.4);
text(ax,0.9,1.82,'--','FontSize',11,'FontWeight','bold','Color',EC_S,'Interpreter','none');
text(ax,2.2,1.82,'ALL OTHER CONDITIONS','FontSize',9.5,'FontWeight','bold','Color',C_DARK);
text(ax,2.2,1.48,'no rule fires','FontSize',8.5,'FontAngle','italic','Color',[0.35 0.35 0.35]);
plot(ax,[17.6 19.0],[1.82 1.82],'Color',[0.55 0.55 0.55],'LineWidth',1.1);
patch(ax,[19.0 18.6 18.6],[1.82 1.95 1.69],[0.55 0.55 0.55],'EdgeColor','none');
rectangle('Parent',ax,'Position',[19.1 1.45 9.0 0.74], ...
    'Curvature',0.12,'FaceColor',FC_S,'EdgeColor',EC_S,'LineWidth',1.8);
text(ax,23.6,1.82,'SIDEWAYS (NEUTRAL)','HorizontalAlignment','center','FontSize',9.5, ...
    'FontWeight','bold','Color',C_DARK,'Interpreter','none');

% Priority flow arrows on left
for r = 1:6
    if r < 6
        plot(ax,[0.20 0.20],[rule_y(r)-0.42 rule_y(r+1)+0.42], ...
            'Color',[0.72 0.72 0.72],'LineWidth',1.2);
    end
end
plot(ax,[0.20 0.20],[rule_y(6)-0.42 1.40+0.84], ...
    'Color',[0.72 0.72 0.72],'LineWidth',1.2);

% Header
text(ax,15.0,11.0, ...
    sprintf(['6-Rule Duration Strategy  |  Persistence = %d months  |  ' ...
             'Lag = %d month  |  Active IR = %.2f   Ann = %+.2f%%   Switches = %d'], ...
             PERSIST_MONTHS, IMPL_LAG, ir_a, ar_a*100, sw_total), ...
    'HorizontalAlignment','center','FontSize',10.5,'FontWeight','bold','Color',C_DARK);
text(ax,15.0,10.55,'Rules evaluated in priority order (P1 highest). First matching rule determines the regime.', ...
    'HorizontalAlignment','center','FontSize',8.5,'FontAngle','italic','Color',[0.45 0.45 0.45]);

exportgraphics(fig1,fullfile(OUT_DIR,'fig1_rule_diagram.png'),'Resolution',200);
fprintf('  Fig 1 saved (rule diagram)\n');

% ── Figure 2: Allocation & Performance (3-panel) ─────────────
fig2 = figure('Name','Allocation & Performance','NumberTitle','off', ...
    'Position',[50 50 1280 1020],'Color','w');

% Panel 1: 2Y yield + Fed Funds + regime shading
ax1 = subplot(3,1,1); hold(ax1,'on');
ylim(ax1,[-0.3 11.2]);  % set before shade so fill uses correct limits
shade_regimes(ax1, DATES, tilt, C_FALL, C_RISE);
plot(ax1,DATES,Y2,'Color',C_DARK,'LineWidth',1.8,'DisplayName','2Y Yield');
plot(ax1,DATES,FF,'Color',C_SIDE,'LineWidth',0.9,'LineStyle',':', ...
    'DisplayName','Fed Funds Rate');

% Regime-change episode annotations
ep_dates  = {'1994-05','2001-01','2008-09','2019-10','2020-03','2022-03','2023-11'};
ep_labels = {'1994 SHORT (R4)','2001 LONG (R5)','GFC LONG (R5+R6)', ...
             '2019 LONG (R5)','COVID LONG (R5)','2022 SHORT (R1+R3)','2023 pivot (R2)'};
ep_ypos   = [7.9 4.7 3.1 2.8 1.4 2.1 5.6];
for k = 1:length(ep_dates)
    ep_dt = datetime(ep_dates{k},'InputFormat','yyyy-MM');
    [~,ii] = min(abs(DATES - ep_dt));
    if ii < 1 || ii > N, continue; end
    text(ax1,DATES(ii),ep_ypos(k),ep_labels{k},'FontSize',7.0,'Color','#333333', ...
        'HorizontalAlignment','center', ...
